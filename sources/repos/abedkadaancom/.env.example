# All variables are optional and browser-visible (Vite inlines VITE_* at build time).
# Never put a Supabase service-role key here.

# Optional cloud facility (apply supabase/migrations first)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional verified Harness Master contact routes
VITE_HM_CONTACT_EMAIL=
VITE_HM_BOOKING_URL=
