[Unit]
Description=Poly IA dedicated HTTPS reverse proxy
Wants=network-online.target
Requires=polyia-ingress.service
After=network-online.target polyia-ingress.service

[Service]
User=polyia-proxy
Group=polyia-proxy
Environment=XDG_DATA_HOME=/var/lib/polyia-proxy/data
Environment=XDG_CONFIG_HOME=/var/lib/polyia-proxy/config
ExecStartPre=/opt/polyia/proxy/caddy validate --config /etc/polyia-proxy/Caddyfile --adapter caddyfile
ExecStart=/opt/polyia/proxy/caddy run --config /etc/polyia-proxy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
StateDirectory=polyia-proxy
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectProc=invisible
ReadWritePaths=/var/lib/polyia-proxy
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
