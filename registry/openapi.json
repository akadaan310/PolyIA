                          }
                        },
                        "required": [
                          "kind"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "target",
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "command_id",
              "expected_revision",
              "kind",
              "payload"
