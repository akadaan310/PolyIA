            "properties": {
              "command_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "minLength": 1,
                "maxLength": 128
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "kind": {
                "const": "experiment.run"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "polynomial",
                      "grammar-promotion",
                      "qpath",
                      "acceptance",
                      "native",
                      "intake",
                      "astra"
                    ]
                  },
                  "parameters": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Bounded registered input. Native requires {source}; intake requires {text}, optional format text/polyia and style concise/tutorial; astra requires its versioned operation envelope. Only original four experiments support {} defaults. No ambient host execution."
                  }
                },
                "required": [
                  "name",
                  "parameters"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "command_id",
              "expected_revision",
              "kind",
              "payload"
            ],
            "additionalProperties": false
          }
        ],
        "description": "Exactly four top-level fields. Unknown payload fields are refused. The expected revision guards new commands; exact retries recover the original receipt. IDs are actor-scoped."
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "command_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "minLength": 1,
            "maxLength": 128
          },
          "actor": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "head": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "result": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "ok",
          "command_id",
          "actor",
          "revision",
          "head",
          "result"
        ],
        "additionalProperties": false
      },
      "Requirement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string"
          },
          "verifier": {
            "type": "string"
          },
          "status": {
            "enum": [
              "NOT_STARTED",
              "PRODUCED",
              "VERIFIED",
              "ACCEPTED"
            ]
