{
  "openapi": "3.1.0",
  "info": {
    "title": "Poly IA commissioning bootstrap",
    "version": "1.0.0",
    "description": "Authenticated command service bound to loopback behind an exact public HTTPS origin. Native programs use a bounded typed interpreter; intake retains source spans; Astra uses explicit versions. No model inference or full-mission acceptance is claimed. Global connection admission returns 429/503; logs use fixed categories without user content."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same-origin service or explicitly configured HTTPS reverse proxy"
    }
  ],
  "security": [
    {
      "operatorBearer": []
    },
    {
      "readBearer": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Non-sensitive process liveness",
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Explicit refusal or service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/.well-known/polyia.json": {
      "get": {
        "summary": "Public protocol and capability discovery",
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Discovery"
                }
              }
            }
          },
          "default": {
            "description": "Explicit refusal or service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This OpenAPI document",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Memory-token browser command plane",
        "security": [],
        "responses": {
          "200": {
            "description": "Static interface; contains no authentication token or ledger state",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/state": {
      "get": {
        "summary": "Read the current durable state envelope",
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "default": {
            "description": "Explicit refusal or service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "summary": "Resume ordered committed events",
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            }
          },
          "default": {
            "description": "Explicit refusal or service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 1000
            }
          }
        ],
        "description": "after is exclusive. Resume using next_after; an empty page preserves the supplied cursor. Feed is JSON polling, not SSE or WebSocket."
      }
    },
    "/v1/commands": {
      "post": {
        "summary": "Apply or recover one authenticated command",
        "security": [
          {
            "operatorBearer": []
          }
        ],
        "description": "Requires Content-Length, application/json (optional charset=utf-8), at most 65536 body bytes, unique object keys, finite numbers and depth at most 32. Fixed HTTP actor is operator. A 200 receipt means the operation was recorded; inspect result for scientific/verifier status.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed receipt, including exact idempotent retries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or refused command",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Read token or disallowed Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision, idempotency, integrity, or state transition conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body budget exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported JSON media type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Other safe service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/commands/{command_id}": {
      "get": {
        "summary": "Read a committed command receipt",
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "default": {
            "description": "Explicit refusal or service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "command_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "description": "Looks up IDs across actors; AMBIGUOUS_COMMAND (409) is returned if the same ID belongs to multiple actors. Unknown IDs return 404."
      }
    },
    "/v1/checkpoints/latest": {
      "get": {
        "summary": "Read the latest source-linked snapshot",
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Checkpoint"
                }
              }
            }
          },
          "default": {
            "description": "Explicit refusal or service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Returns NOT_FOUND (404) until a checkpoint exists."
      }
    },
    "/v1/checkpoints/{checkpoint_id}": {
      "get": {
        "summary": "Read an immutable checkpoint",
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Checkpoint"
                }
              }
            }
          },
          "default": {
            "description": "Explicit refusal or service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "checkpoint_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ]
      }
    },
    "/v1/verify": {
      "get": {
        "summary": "Recompute ledger, artifact and checkpoint integrity",
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verification"
                }
              }
            }
          },
          "default": {
            "description": "Explicit refusal or service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Read operation; 200 can contain ok:false with diagnostics. It never repairs corruption."
      }
    },
    "/v1/refusals": {
      "get": {
        "summary": "Read separate ledger command refusal diagnostics",
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusals"
                }
              }
            }
          },
          "default": {
            "description": "Explicit refusal or service error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 1000
            }
          }
        ],
        "description": "HTTP prevalidation and authentication failures are not retained in this ledger refusal journal. Refusals do not advance revision."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "operatorBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "POLYIA_OPERATOR_TOKEN: read and command authority. Never place it in a URL."
      },
      "readBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Optional distinct POLYIA_READ_TOKEN: authenticated reads only."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
